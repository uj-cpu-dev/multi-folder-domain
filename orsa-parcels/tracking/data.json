{
  "_comment": [
    "Everything on the page comes from this file. Change it, refresh, done.",
    "",
    "The one key that changes everything is parcel.state. It picks a colour,",
    "a badge word and how the progress bar behaves. Set it to 'failed' and",
    "the whole screen turns amber, the bar stops where the parcel stopped,",
    "and the rest of the journey goes dashed because it is no longer known.",
    "",
    "Add your own states to the 'states' block below. A state needs a tone",
    "(good, done, warn, bad, cool, mute) and a badge word. Nothing else."
  ],

  "brand": {
    "name": "Orsa",
    "nameThin": "Parcels",
    "site": "orsaparcels.com",
    "accent": "oklch(0.88 0.21 128)",
    "accentDeep": "oklch(0.72 0.18 130)",
    "accentInk": "oklch(0.20 0.06 130)"
  },

  "states": {
    "booked": { "tone": "cool", "badge": "Booked", "live": false },
    "in_transit": { "tone": "good", "badge": "Live", "live": true },
    "out_for_delivery": { "tone": "good", "badge": "Live", "live": true },
    "delivered": {
      "tone": "done",
      "badge": "Delivered",
      "live": false,
      "complete": true
    },
    "delayed": { "tone": "warn", "badge": "Delayed", "live": true },
    "on_hold": {
      "tone": "warn",
      "badge": "On hold",
      "live": false,
      "rest": "unknown"
    },
    "attempted": {
      "tone": "warn",
      "badge": "Attempted",
      "live": false,
      "rest": "unknown"
    },
    "needs_you": {
      "tone": "bad",
      "badge": "Action needed",
      "live": false,
      "rest": "unknown"
    },
    "damaged": {
      "tone": "bad",
      "badge": "Damaged",
      "live": false,
      "rest": "unknown"
    },
    "lost": {
      "tone": "bad",
      "badge": "Investigating",
      "live": false,
      "rest": "unknown"
    },
    "returning": {
      "tone": "cool",
      "badge": "Coming back",
      "live": true,
      "rest": "unknown"
    },
    "cancelled": {
      "tone": "mute",
      "badge": "Cancelled",
      "live": false,
      "rest": "unknown"
    }
  },

